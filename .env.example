# ART demo environment config.
# Copy this file to .env and fill in real values. .env is gitignored —
# this file is the committed template so the repo documents what's
# needed without leaking credentials.

# Engine type. Only "postgresql" is implemented today. This field exists
# so a new engine (e.g. sql server) can be added later as its own adapter
# without touching create_env.py's orchestration logic — see SqlAdapter /
# ADAPTERS in create_env/create_env.py.
DB_TYPE=postgresql

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

PRE_DB_NAME=art_pre
POST_DB_NAME=art_post

# Schema (created in both DBs) holding ART's metadata tables:
# reports_metadata, params_metadata, and one candidates_<report> table
# per onboarded report. Must be a plain lowercase identifier.
ART_SCHEMA=art
